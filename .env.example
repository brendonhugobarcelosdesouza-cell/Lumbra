# Copie para .env em desenvolvimento. NUNCA commite .env.
LUMBRA_ENVIRONMENT=local
LUMBRA_DATABASE__DSN=postgresql+asyncpg://lumbra:lumbra@localhost:5432/lumbra
LUMBRA_REDIS__URL=redis://localhost:6379/0
LUMBRA_SECURITY__JWT_SECRET=troque-este-valor
LUMBRA_OBSERVABILITY__LOG_JSON=false
LUMBRA_OBSERVABILITY__LOG_LEVEL=DEBUG
